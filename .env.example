# Add Fantahun's confirmed professional contact email to enable direct email inquiries.
# Without it, the contact form provides a copyable inquiry instead of pretending to send.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional official LinkedIn URL. If blank, the site does not invent a profile link.
NEXT_PUBLIC_LINKEDIN_URL=
# Optional official Instagram URL.
NEXT_PUBLIC_INSTAGRAM_URL=
